[Unit]
Description=Create a consistent snapshot of the homelab event ledger

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/homelab/scripts/homelab-events/snapshot_live_db.py --source /opt/homelab/data/homelab-events/events.db --destination /opt/homelab/data/homelab-events/events.db.snapshot
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/opt/homelab/data/homelab-events
