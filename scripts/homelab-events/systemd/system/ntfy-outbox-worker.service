[Unit]
Description=Guarded ntfy notification outbox drain
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/homelab/data/homelab-events/events.db
ConditionPathExists=/opt/homelab/scripts/homelab-events/config/policy.yaml

[Service]
Type=oneshot
User=homelab
Group=homelab
WorkingDirectory=/opt/homelab
EnvironmentFile=-/opt/homelab/compose/.env
Environment=HOMELAB_EVENTS_ENABLE_DELIVERY=0
Environment=NTFY_BASE_URL=https://ntfy.example.duckdns.org
Environment=PYTHONPATH=/opt/homelab/scripts/homelab-events
ExecStart=/usr/bin/python3 -m homelab_events.delivery.outbox_worker --db /opt/homelab/data/homelab-events/events.db --policy /opt/homelab/scripts/homelab-events/config/policy.yaml --base-url https://ntfy.example.duckdns.org --send --enable-production-delivery --timeout 10 --limit 10
TimeoutStartSec=30
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/homelab/data/homelab-events
