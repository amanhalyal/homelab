[Unit]
Description=Enrich queued digest events with Cerberus briefs (on-demand model)

[Service]
Type=oneshot
WorkingDirectory=/opt/homelab
Environment=PYTHONPATH=/opt/homelab/scripts/homelab-events
ExecStart=/usr/bin/python3 -m homelab_events.enrichment.cerberus_drain --db /opt/homelab/data/homelab-events/events.db
TimeoutStartSec=15min
Nice=10
