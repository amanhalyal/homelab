# Copy to .env next to docker-compose.yml. Placeholders only.

# Checkout of this repo on Citadel.
CITADEL_DIR=/opt/homelab/citadel
# Legion's Tailscale address, where the Scrutiny hub listens.
LEGION_TAILSCALE_IP=100.64.0.1
# Ping URL of an external dead-man's-switch service (for example a
# healthchecks.io check). Treat it as a secret: anyone with it can fake a heartbeat.
HEALTHCHECK_PING_URL=https://hc-ping.example/00000000-0000-0000-0000-000000000000
