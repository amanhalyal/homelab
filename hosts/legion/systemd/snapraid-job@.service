[Unit]
Description=Guarded SnapRAID %i for Arcadia
RequiresMountsFor=/mnt/atlas /mnt/aegir /mnt/argus
BindsTo=mnt-atlas.mount mnt-aegir.mount mnt-argus.mount
After=mnt-atlas.mount mnt-aegir.mount mnt-argus.mount

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/snapraid/snapraid_job.py %i
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
TimeoutStartSec=2d
TimeoutStopSec=180
KillMode=mixed
KillSignal=SIGINT
